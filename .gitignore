data/*.db
data/*.db-journal
data/*.db-wal
data/*.db-shm
data/*.log
# 手动备份：改动数据结构前自己拷的快照，体积大且含真实抓取数据，勿提交
data/*.bak*

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# 开发期截图（含真实抓取数据，勿公开）
_shots/

