# ============================================================
#  threads-ai-radar —— 配置示例
#  复制为 .env 后按需修改。所有项都有内置默认值，可以整个留空。
# ============================================================

# --- 服务 ---
RADAR_HOST=127.0.0.1
RADAR_PORT=8650

# --- 代理（直连 threads.com 不通时必填）---
# 本程序用 Python 标准库 urllib 抓取，urllib 会自动读取系统的
# http_proxy / https_proxy 环境变量，所以这里一般不用写。
#
# 两种配置方式，二选一：
#
#  ① 推荐：设成系统环境变量（Windows 命令行临时生效）
#       set http_proxy=http://127.0.0.1:7890
#       set https_proxy=http://127.0.0.1:7890
#     或者填到本文件里（取消下面两行注释，改成你自己的端口）：
#
# http_proxy=http://127.0.0.1:7890
# https_proxy=http://127.0.0.1:7890
#
#  ② 端口怎么找：Clash / v2rayN 等客户端的「混合端口 / HTTP 端口」。
#
# ⚠ 代理必须开着才能采集。关掉代理后通道会报 502（proxy_tunnel_502），
#    那是代理到 Meta 的链路不通，不是代码问题。
#    排查时先拿 baidu.com / api.github.com 对比：这两个通、只有 threads.com
#    不通 → 是出口被 Meta 风控；三个都不通 → 是代理本身挂了。
#
# ⚠ 不要写 socks5:// 开头的地址。urllib 不支持 socks 代理，
#    请用 Clash 等客户端的 HTTP 混合端口（形如 http://127.0.0.1:7890）。

# --- 实时监控 ---
# 每轮采集的间隔（分钟）。界面里改间隔会自动写回 .env。
# ⚠ 长期挂机建议 ≥30 分钟。
RADAR_INTERVAL_MINUTES=30
# 启动服务时是否立刻跑一轮
RADAR_COLLECT_ON_START=1
# 关键词之间的抖动间隔（秒），避免固定频率被风控
RADAR_JITTER_MIN=1.8
RADAR_JITTER_MAX=4.2
RADAR_REQUEST_TIMEOUT=45
RADAR_RETRIES=2
# 单轮采集的硬性时间上限（秒）。到点中止本轮，避免休眠/卡死把下一轮无限期堵住。
# 实测笔记本休眠会让采集线程整个冻住（曾卡 15.5 小时），必须有这层兜底。
RADAR_CYCLE_MAX_SECONDS=1800
# 连续多少轮「整轮零产出」后自动暂停（熔断）。整轮零产出 = 通道级故障，硬重试只会加深封禁。
RADAR_FAILURE_LIMIT=3

# --- 抓取变体 ---
# 每个关键词抓哪几种搜索结果变体。各变体返回不同批次的结果，多取几个相当于翻页。
# 经验：base,profile 是性价比最高的组合（相关帖产出约 2.7 倍，耗时约 2 倍）。
# 注意要按「相关帖产出」选，不要按「原始条数」选 —— recent 原始条数多但几乎全是噪音。
# 可选：base,profile,default,recent,top,tag
#
# ⚠ 变体数直接决定封禁风险：实测 3 变体 × 19 词 = 57 请求/轮，按 15 分钟间隔连跑三轮后
#    threads.com 就对出口返回 502（约 20 分钟自愈）。一次性抓取可以用 3 个，
#    长期挂机请控制在此 2 个以内。
RADAR_SERP_TYPES=base,profile

# --- 展示 ---
# 榜单最多保留多少条
RADAR_TOP_N=300
# 界面「最低互动」滑块的初始阈值（口径：赞/回/转 三项取最大，而非相加）
RADAR_MIN_INTERACTIONS=30

# --- 数据保留 ---
# 互动快照保留天数
RADAR_SNAPSHOT_RETENTION_DAYS=60

# --- 高级：采集标识 ---
# 换成普通浏览器 UA 会拿到空壳页面（无任何帖子数据），非必要不要改。
# RADAR_USER_AGENT=Mozilla/5.0 (compatible; Googlebot/2.1; +http://www.google.com/bot.html)
